# mm6mcp configuration example
# Copy to .env, then replace placeholders with values for your own environment.
# Do not commit .env or share tokens / secrets.

# Required by mcp/entrypoint.sh / OpenAI Secure MCP Tunnel.
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_YOUR_TUNNEL_ID
CONTROL_PLANE_API_KEY=REPLACE_WITH_YOUR_RUNTIME_API_KEY
TUNNEL_LOG_LEVEL=warn

HARPOON_ALLOW_PLAINTEXT_HTTP=1
HARPOON_HOSTS_INCLUDE_LOOPBACK=1
HARPOON_HOSTS_INCLUDE_PRIVATE=0

MANIPULATOR_URL=http://host.docker.internal:50052

# The tested OAuth configuration uses Amazon Cognito.
# Keeping authentication enabled makes incomplete setup fail closed.
MCP_AUTH_ENABLED=1
COGNITO_REGION=REPLACE_WITH_AWS_REGION
COGNITO_USER_POOL_ID=REPLACE_WITH_USER_POOL_ID
COGNITO_CLIENT_ID=REPLACE_WITH_COGNITO_APP_CLIENT_ID
COGNITO_REQUIRED_SCOPES=REPLACE_WITH_RESOURCE_SERVER_SCOPE

# Set these according to your Cognito and externally visible MCP URLs.
COGNITO_AUTHORIZATION_ENDPOINT=https://REPLACE_WITH_COGNITO_DOMAIN/oauth2/authorize
COGNITO_TOKEN_ENDPOINT=https://REPLACE_WITH_COGNITO_DOMAIN/oauth2/token
MCP_AUTHORIZATION_SERVER_URL=http://127.0.0.1:8000/oauth
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp

# Optional principal restrictions; set these if appropriate for your deployment.
# Leaving all of them empty does NOT restrict access to a particular user.
COGNITO_ALLOWED_USERNAME=
COGNITO_ALLOWED_SUB=
COGNITO_ALLOWED_GROUP=
COGNITO_EXPECTED_AUDIENCE=

# Optional verification overrides. By default, issuer and JWKS URL are
# derived from COGNITO_REGION and COGNITO_USER_POOL_ID.
# COGNITO_ISSUER=
# COGNITO_JWKS_URL=
JWT_DECODE_ALGORITHMS=RS256

# Container-internal MCP listener and Windows Manipulator connection.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp
MANIPULATOR_HOST=host.docker.internal
MANIPULATOR_PORT=50052
MANIPULATOR_TIMEOUT_SECONDS=10

# Do not enable except for debugging in a controlled environment.
MCP_DUMP_TOKEN=0
